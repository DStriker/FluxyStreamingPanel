{
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "jsx": "react-jsx",
    "types": ["vite/client"],

    "strict": true,
    "noUncheckedIndexedAccess": true,
    "noImplicitOverride": true,
    "noFallthroughCasesInSwitch": true,

    // Checked by `npm run typecheck` and by `npm run build` before vite runs. Nothing is
    // emitted: vite is the bundler, tsc is only the checker.
    "noEmit": true,
    "isolatedModules": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,

    // Nothing under `src/` is JavaScript, so the two extensions are out of the compilation
    // entirely - written out rather than left to the default so the state is visible in the
    // file. The JavaScript that remains (the two configs, everything under `scripts/`) sits
    // outside `include` on purpose: it is build tooling, not the application.
    "allowJs": false
  },
  "include": ["src"]
}
