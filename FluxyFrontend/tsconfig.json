{
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "jsx": "react-jsx",
    "types": ["vite/client"],

    "strict": true,
    "noUncheckedIndexedAccess": true,
    "noImplicitOverride": true,
    "noFallthroughCasesInSwitch": true,

    // Checked by `npm run typecheck` and by `npm run build` before vite runs. Nothing is
    // emitted: vite is the bundler, tsc is only the checker.
    "noEmit": true,
    "isolatedModules": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,

    // Kept until the last file is renamed - `allowJs` is what lets a half-migrated tree
    // typecheck, and it goes away in the same commit that moves the final file.
    "allowJs": true
  },
  "include": ["src"]
}
