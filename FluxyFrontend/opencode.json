{
  "$schema": "https://opencode.ai/config.json",
  "permission": {
    "edit": "ask",
    "bash": {
      "*": "ask",
      "ls": "allow"
    }
  },
  "mcp": {
	"servers": {
		"antd": {
		  "type": "local",
		  "enabled": true,
		  "command": ["antd", "mcp"],
		  "environment": { "NO_UPDATE_CHECK": "1" },
  		  "timeout": { "startup": 120000 }
		},
		"playwright": {
		  "type": "local",
		  "enabled": true,
		  "command": ["npx", "@playwright/mcp@latest"]
		}
	}
  }
}