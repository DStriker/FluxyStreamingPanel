{
  "$schema": "https://opencode.ai/config.json",
  "permission": {
    "edit": "ask",
    "bash": {
      "*": "ask",
      "ls": "allow"
    }
  },
  "mcp": {
	"servers": {
		"antd": {
		  "type": "local",
		  "enabled": true,
		  "command": ["npx", "-y", "@ant-design/cli", "mcp"]
		},
		"playwright": {
		  "type": "local",
		  "enabled": true,
		  "command": ["npx", "@playwright/mcp@latest"]
		}
	}
  }
}