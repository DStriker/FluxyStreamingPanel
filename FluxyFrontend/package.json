{
  "name": "refluxy-frontend",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "favicon": "node scripts/generate-favicons.mjs",
    "probe": "esbuild --bundle scripts/probe-registration.mjs --format=esm --platform=node --outfile=node_modules/.cache/probe-registration.mjs --log-level=error && node scripts/run-probe.mjs",
    "probe:render": "esbuild --bundle scripts/probe-render.jsx --format=cjs --platform=node --jsx=automatic --outfile=node_modules/.cache/probe-render.cjs --log-level=error && node node_modules/.cache/probe-render.cjs",
    "lint": "eslint ."
  },
  "dependencies": {
    "antd": "^6.6.5",
    "i18next": "^26.4.2",
    "react": "^19.1.1",
    "react-dom": "^19.1.1",
    "react-i18next": "^17.0.15",
    "react-router-dom": "^7.18.4"
  },
  "devDependencies": {
    "@eslint/js": "^9.37.0",
    "@resvg/resvg-js": "^2.6.2",
    "@types/react": "^19.1.13",
    "@types/react-dom": "^19.1.9",
    "@vitejs/plugin-basic-ssl": "^2.3.0",
    "@vitejs/plugin-react": "^5.0.4",
    "eslint": "^9.37.0",
    "eslint-plugin-react-hooks": "^6.1.1",
    "eslint-plugin-react-refresh": "^0.4.20",
    "globals": "^16.5.0",
    "vite": "^7.1.9"
  }
}
