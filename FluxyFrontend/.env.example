# Шаблон окружения фронтенда. Копируется в .env, который в .gitignore.
#
#   copy .env.example .env
#
# Переменные подставляются на этапе сборки, поэтому после правки нужен перезапуск
# `npm run dev` или новая сборка - горячая перезагрузка их не подхватит.

# --- Адрес API ---
# Пусто или не задано -> запросы идут на тот же origin, что и страница. Так правильно
# и для production (фронтенд и бэкенд за одним хостом/прокси), и для разработки, где
# vite проксирует /auth на бэкенд (см. VITE_API_PROXY_TARGET).
#
# НЕ указывайте здесь адрес бэкенда при разработке. Куки antiforgery помечены
# SameSite=Lax, а «сайт» в SameSite включает схему, поэтому страница на
# http://localhost:5173 и API на https://localhost:7221 — это кросс-сайтовый запрос:
# браузер не отправит куки на POST и не покажет их в document.cookie, токен не достанется,
# и каждая отправка формы вернёт csrf_invalid. Прямое подключение по https не спасает.
VITE_API_BASE_URL=

# Куда проксировать /auth в dev (`npm run dev` и `npm run preview`). Только для разработки,
# в сборку не попадает. Именно http-порт бэкенда, то есть запуск:
#   dotnet run --project Fluxy.API --launch-profile http
# Профиль https не годится: он ставит на куки флаг secure, а браузер выбрасывает secure-куку,
# полученную по http-соединению с :5173, и вдобавок этот профиль отдаёт 307 с http-порта.
VITE_API_PROXY_TARGET=http://localhost:5159

# --- Маршруты SPA ---
VITE_REGISTER_ROUTE=register
VITE_CLIENT_LOGIN_ROUTE=login
VITE_RESELLER_LOGIN_ROUTE=reseller/login
VITE_ADMIN_LOGIN_ROUTE=admin/login
# Сброс пароля: страница, на которую ведёт ссылка «Забыли пароль?» в подвале всех
# трёх форм входа. Гостевой маршрут, как и остальные выше.
VITE_FORGOT_PASSWORD_ROUTE=forgot-password

# Куда попадает роль после входа. Должны совпадать с секцией Auth в appsettings.json
# бэкенда: сервер присылает путь в `redirect`, а роутер обязан иметь такой маршрут.
# Путь — это и корень области: на нём стоит RequireAuth с проверкой роли и AccountLayout,
# а пункты меню вешаются на него как дочерние маршруты.
VITE_CLIENT_HOME_ROUTE=client/index
VITE_RESELLER_HOME_ROUTE=reseller/dashboard
VITE_ADMIN_HOME_ROUTE=admin/dashboard

# --- reCAPTCHA v3 ---
# Публичный ключ, попадает в сборку и потому не секрет. Приватный ключ нужен
# бэкенду и лежит в его .env, а не здесь.
# Пусто -> captcha не запрашивается вовсе.
VITE_RECAPTCHA_SITE_KEY=