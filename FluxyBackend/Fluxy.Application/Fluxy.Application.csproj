<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
  </PropertyGroup>

  <ItemGroup>
    <!-- This layer references Core only. Persistence and the readers of external data live
         behind the Core interfaces, so neither Entity Framework, nor StackExchange.Redis, nor
         MaxMind.GeoIP2 belongs here - and without a DataAccess reference the MSB3277 pin that
         used to be necessary has nothing left to pin. -->
    <PackageReference Include="MailKit" Version="4.18.1" />
    <!-- MimeKit 4.18.1 asks for Pkcs 10.0.0, which carries two published advisories. Pinning
         the patched servicing version keeps the mail dependency from dictating a vulnerable one. -->
    <PackageReference Include="System.Security.Cryptography.Pkcs" Version="10.0.13" />
    <PackageReference Include="Microsoft.Extensions.Http" Version="10.0.12" />
    <!-- Pinned for the same reason as Http above: IHostEnvironment is what the sign-in, refresh
         and profile paths ask whether local networks are bypassed in Development, and an
         unpinned Hosting would resolve below the 10.0.12 the host runs. -->
    <PackageReference Include="Microsoft.Extensions.Hosting" Version="10.0.12" />
    <!-- Pinned to exactly what Microsoft.AspNetCore.Authentication.JwtBearer 10.0.12 resolves
         in Fluxy.API, for the same reason Relational is pinned above. The token service mints
         here and the scheme validates there, and a mismatch between the two is either an
         MSB3277 or a signature the two halves disagree about. -->
    <PackageReference Include="System.IdentityModel.Tokens.Jwt" Version="8.19.2" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Fluxy.Core\Fluxy.Core.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="BCrypt.Net-Next" Version="4.2.0" />
  </ItemGroup>

</Project>
