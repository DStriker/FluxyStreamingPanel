# Секреты Fluxy: локальная инфраструктура и настройки приложения.
#
# Этот файл БЕЗ реальных паролей и попадает в git.
# Реальные значения живут в .env (он в .gitignore). Часть генерируется:
#
#   powershell -ExecutionPolicy Bypass -File scripts\init-secrets.ps1
#
# Compose читает .env из своей папки автоматически и подставляет значения
# в compose.yaml. Если обязательная переменная не задана - compose падает
# с внятной ошибкой, а не стартует с пустым паролем.
#
# Приложение читает тот же файл (Fluxy.API/Configuration/
# DotEnvConfigurationExtensions.cs) и берёт оттуда SMTP_* и
# RECAPTCHA_SECRET_KEY. Поэтому секреты НЕ дублируются в appsettings.json:
# там их нет вообще, ни даже пустыми заглушками - заглушка с пустой строкой
# перекрыла бы настоящее значение из .env, потому что appsettings имеет
# более высокий приоритет.

# --- postgres (5432, доступен из локальной сети) ---
POSTGRES_DB=fluxy
POSTGRES_USER=fluxy
# 32 случайных байта в hex. В docker inspect виден как есть - это осознанный
# компромисс dev-окружения, для общего доступа нужен внешний секрет-менеджер.
POSTGRES_PASSWORD=

# --- pgadmin (5050 -> http://localhost:5050) ---
PGADMIN_EMAIL=mainuser@mail.com
PGADMIN_PASSWORD=

# --- redis (6379, доступен из локальной сети) ---
# Приложение ходит как REDIS_USER. В контейнер уходит только SHA-256 хеш
# (REDIS_ACL_HASH), открытый пароль остаётся на хосте.
# Права пользователя: +@all -@admin -@dangerous, то есть чтение и запись
# любых данных, но без CONFIG / MODULE / DEBUG / FLUSHALL / FLUSHDB /
# SHUTDOWN / REPLICAOF / RESTORE / KEYS / SCRIPT / SORT.
REDIS_USER=fluxy
# Открытый пароль - только для ручного redis-cli с хоста.
REDIS_PASSWORD=
REDIS_ACL_HASH=

# Необязательно. Пусто -> пользователь dev-admin не создаётся.
# Заполняется: scripts\init-secrets.ps1 -RedisAdmin
# Даёт полные права (+@all) для ручной отладки и для RedisInsight
# (compose, сервис redisinsight). Не использовать из приложения и не
# оставлять включённым на машине, доступной другим.
# Открытый пароль уходит в docker inspect контейнера redisinsight -
# это осознанный компромисс, как у POSTGRES_PASSWORD.
REDIS_ADMIN_PASSWORD=
REDIS_ADMIN_ACL_HASH=

# --- Почта (нужна для POST /auth/register) ---
# Пусто -> SmtpEmailSender считает почту не настроенной, и регистрация
# отвечает 503 registration_not_configured, ничего не записывая в базу.
# SMTP_USER и SMTP_PASSWORD - пара: заданная только одна из них считается
# ошибкой настройки и пишется в лог.
# Значение с ';' или '=' обязательно пиши в кавычки:
#   SMTP_PASSWORD="pa;ss=word"
# Compose эти переменные игнорирует, они нужны только приложению.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
# STARTTLS после приветствия. На 465 TLS идёт до приветствия и включается
# всегда, так что здесь достаточно false.
SMTP_USE_TLS=true
# Отправитель, на который сервер спрашивает подтверждение.
SMTP_FROM=

# --- JWT ---
# Ключ подписи access токенов. Обязателен (HS256), минимум 32 байта в hex.
# Генерируется скриптом: scripts\init-secrets.ps1 (добавляет JWT_SIGNING_KEY).
# Ротация ключа инвалидирует все выданные access токены сразу.
JWT_SIGNING_KEY=
JWT_ISSUER=fluxy
JWT_AUDIENCE=fluxy-api

# --- reCAPTCHA v3 ---
# Приватный ключ из https://www.google.com/recaptcha/admin.
# Пусто -> проверка полностью пропускается и каждая регистрация принимается
# на слово; при старте об этом пишется предупреждение.
# Публичный site key живёт во фронтенде, бэкенду он не нужен.
RECAPTCHA_SECRET_KEY=

# --- CORS (только браузер) ---
# CORS - механизм браузера, а не сервера. Он решает, может ли страница
# с чужого origin прочитать ответ. curl, нативное приложение и
# сервер-в-сервер его не смотрят вообще, поэтому внешним клиентам,
# которым он не нужен, достаточно биндинга 0.0.0.0 (профиль запуска lan).
#
# CORS_ENABLED=false выключает политику целиком. Это НЕ то же самое, что
# разрешить всем: браузер при отсутствии подходящей политики отказывает
# по умолчанию, поэтому выключение делает отказ безусловным. Выключать
# имеет смысл, только когда страница и API живут на одном origin - так
# политика и не включается вовсе.
#
# ВАЖНО про политику и antiforgery-куки. Браузер отправляет куки
# SameSite=Lax только на same-site запросы, а сайт - это схема плюс
# registrable domain (порты на это не влияют). Если бэкенд запущен
# профилем https, его http-порт 5159 отвечает 307 на
# https://localhost:7221: браузер уходит на другую схему, запрос
# становится кросс-ориджин, нужен preflight - и origin страницы должен
# быть в списке. Поэтому для локальной работы запускайте бэкенд
# профилем http (dotnet run --project Fluxy.API --launch-profile http).
# Список ниже нужен ровно для этого случая.
#
# CORS_ALLOWED_ORIGINS - точные origin через запятую, каждый со схемой
# и портом. Это адрес, С КОТОРОГО вы открываете фронтенд, а не адрес API.
# Стандартная схема разработки (vite проксирует /auth на бэкенд) делает
# страницу и API одним origin, то есть CORS не участвует и список может
# быть пустым. Он нужен, когда фронтенд открыт напрямую с другого адреса:
# например http://192.168.1.3:5173 или https://app.example.com.
CORS_ENABLED=true
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://localhost:5174

# --- GeoIP (нужен для защиты входа по сетям) ---
# Файлы баз MaxMind (.mmdb), скачиваются по лицензионному ключу с
# https://www.maxmind.com/en/geolite2/signup и в git не попадают.
# Лежат рядом с решением, сборка копирует их в выходную папку API.
# Относительный путь читается от выходной папки (не от рабочей), поэтому
# bare-имени достаточно; абсолютный путь тоже работает (для смонтированного тома).
# Пустые значения -> резолвер отвечает unknown на любой адрес, а аккаунты
# с включённой защитой не могут войти (fail-closed, см. GeoIpOptions).
# Compose эти переменные игнорирует, они нужны только приложению.
GEOIP_CITY_DB_PATH=
GEOIP_ASN_DB_PATH=
