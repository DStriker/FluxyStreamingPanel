# Секреты локальной инфраструктуры Fluxy.
#
# Этот файл БЕЗ реальных паролей и попадает в git.
# Реальные значения живут в .env (он в .gitignore) и генерируются:
#
#   powershell -ExecutionPolicy Bypass -File scripts\init-secrets.ps1
#
# Compose читает .env из своей папки автоматически и подставляет значения
# в compose.yaml. Если обязательная переменная не задана - compose падает
# с внятной ошибкой, а не стартует с пустым паролем.

# --- postgres (5432, доступен из локальной сети) ---
POSTGRES_DB=fluxy
POSTGRES_USER=fluxy
# 32 случайных байта в hex. В docker inspect виден как есть - это осознанный
# компромисс dev-окружения, для общего доступа нужен внешний секрет-менеджер.
POSTGRES_PASSWORD=

# --- pgadmin (5050 -> http://localhost:5050) ---
PGADMIN_EMAIL=mainuser@mail.com
PGADMIN_PASSWORD=

# --- redis (6379, доступен из локальной сети) ---
# Приложение ходит как REDIS_USER. В контейнер уходит только SHA-256 хеш
# (REDIS_ACL_HASH), открытый пароль остаётся на хосте.
# Права пользователя: +@all -@admin -@dangerous, то есть чтение и запись
# любых данных, но без CONFIG / MODULE / DEBUG / FLUSHALL / FLUSHDB /
# SHUTDOWN / REPLICAOF / RESTORE / KEYS / SCRIPT / SORT.
REDIS_USER=fluxy
# Открытый пароль - только для ручного redis-cli с хоста.
REDIS_PASSWORD=
REDIS_ACL_HASH=

# Необязательно. Пусто -> пользователь dev-admin не создаётся.
# Заполняется: scripts\init-secrets.ps1 -RedisAdmin
# Даёт полные права (+@all) для ручной отладки. Не использовать из
# приложения и не оставлять включённым на машине, доступной другим.
REDIS_ADMIN_PASSWORD=
REDIS_ADMIN_ACL_HASH=
